# Supabase - required for auth and database
# Get these from https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required in production for match result completion and server pairing writes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for Render cron → POST /api/cron/pair-active (and optional system pair)
PAIRING_CRON_SECRET=generate-a-long-random-string

# Base URL of the Parego web service (used by scripts/cron-pair-active.mjs)
PAREGO_APP_URL=https://parego.onrender.com

# Sentry error tracking (optional locally; set on Render for production)
# Create a Next.js project at https://sentry.io → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Optional: override environment tag (defaults to NODE_ENV)
# SENTRY_ENVIRONMENT=production
# Optional: source map upload during build (org/project from Sentry settings)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=